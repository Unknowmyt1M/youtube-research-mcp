# ==============================================================================
# YouTube Research MCP — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUD & DEPLOYMENT SETTINGS (Railway / Render / Fly.io / Docker)
# ------------------------------------------------------------------------------
# Dynamic port injected by cloud hosting platforms (e.g. Railway sets PORT automatically)
# PORT=8080
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=http
MCP_SERVER_NAME=youtube-research-mcp
LOG_LEVEL=INFO
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (SEC-001, SEC-002, SEC-003)
# ------------------------------------------------------------------------------
# Set this secret to require authentication for /api/admin/* endpoints.
# If unset (None), admin endpoints are open for local development.
# Client sends: "Authorization: Bearer <ADMIN_API_KEY>" or "X-Admin-Key: <ADMIN_API_KEY>"
ADMIN_API_KEY=

# Allowed CORS origins for web dashboard / admin access (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Whether public /api/* endpoints allow all origins (ChatGPT plugin requirement)
CORS_ALLOW_ALL_API=true

# Rate Limiting configuration (Token Bucket on HTTP REST endpoints)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10.0
RATE_LIMIT_BURST=20.0

# ------------------------------------------------------------------------------
# 3. RESOURCE SAFETY & BOUNDS (RES-001, RES-002, RES-003)
# ------------------------------------------------------------------------------
MAX_QUERY_LENGTH=500
MAX_TRANSCRIPT_SEGMENTS=10000
MAX_CACHE_ENTRIES=20000

# ------------------------------------------------------------------------------
# 4. CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# Supported backends: "sqlite" (default local), "memory" (in-process RAM), "redis" (distributed)
CACHE_BACKEND=sqlite

# SQLite cache file path (used when CACHE_BACKEND=sqlite)
# CACHE_DB_PATH=~/.youtube_research_mcp/cache.db

# Redis connection URL (used when CACHE_BACKEND=redis)
# Format: redis://[[<username>]:<password>@]<host>[:<port>]/<db_number>
# Local Redis example:
REDIS_URL=redis://localhost:6379/0
# Authenticated Redis example (placeholder):
# REDIS_URL=redis://:<PASSWORD>@<HOST>:6379/0

# Redis connection pool & timeout limits
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50

CACHE_SCHEMA_VERSION=v2
CACHE_TTL_SEARCH=43200        # 12 hours
CACHE_TTL_METADATA=604800      # 7 days
CACHE_TTL_TRANSCRIPT=5184000  # 60 days
NEGATIVE_CACHE_TTL=600        # 10 minutes

# ------------------------------------------------------------------------------
# 5. CIRCUIT BREAKER CONFIGURATION
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# ------------------------------------------------------------------------------
# 6. SEMANTIC & RETRIEVAL CONFIGURATION
# ------------------------------------------------------------------------------
USE_ONNX_EMBEDDER=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRID_SEARCH_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
CHUNK_TARGET_WORDS=180
CHUNK_OVERLAP_WORDS=30
MAX_RETRIEVAL_INDEXES=100
INDEX_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. RESEARCH SYNTHESIS CONFIGURATION
# ------------------------------------------------------------------------------
MAX_VIDEOS_PER_CHANNEL=2
EVIDENCE_SIMILARITY_THRESHOLD=0.75
DEFAULT_FALLBACK_LANGUAGE=en

# ------------------------------------------------------------------------------
# 8. OPTIONAL COMMERCIAL BACKEND KEYS (Tier 3 Fallbacks)
# ------------------------------------------------------------------------------
# SUPADATA_API_KEY=
# SEARCHAPI_API_KEY=
# TRANSCRIPT_API_KEY=
# YOUTUBE_DATA_API_KEY=

# ------------------------------------------------------------------------------
# 9. HTTP PROXY & CONNECTION POOLING
# ------------------------------------------------------------------------------
# HTTP_PROXY=http://127.0.0.1:7890
POOL_MAX_CONNECTIONS=50
POOL_MAX_KEEPALIVE=20
