# YouTube Research MCP Configuration
# Server Settings
MCP_SERVER_NAME="youtube-research-mcp"
LOG_LEVEL="INFO"
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=15.0

# Cache Settings
CACHE_BACKEND="sqlite" # sqlite | memory | redis
CACHE_DB_PATH="~/.youtube_research_mcp/cache.db"
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SEARCH=43200     # 12 hours
CACHE_TTL_METADATA=604800  # 7 days
CACHE_TTL_TRANSCRIPT=5184000 # 60 days

# Semantic Search & Embeddings
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
HYBRID_SEARCH_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# Optional Upstream Commercial Keys (Isolated Fallbacks Only - NOT required for normal usage)
SUPADATA_API_KEY=""
SEARCHAPI_API_KEY=""
TRANSCRIPT_API_KEY=""
YOUTUBE_DATA_API_KEY=""
